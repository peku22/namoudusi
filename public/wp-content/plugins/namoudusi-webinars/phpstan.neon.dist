includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - namoudusi-webinars.php
        - uninstall.php
        - src
        - tests
    excludePaths:
        - tests/stubs
        - tests/smoke
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - tests/stubs/wp-cli.php
        - tests/stubs/action-scheduler.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
