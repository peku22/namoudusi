msgid "Na mou duši – Webináře"
msgstr "Na mou duši – Webináře"

msgid "Recorded (Bunny Stream) and live (Zoom) webinars sold via WooCommerce, access in My Account."
msgstr "Nahrané (Bunny Stream) a živé (Zoom) webináře prodávané přes WooCommerce, přístup v sekci Můj účet."

msgid "Na mou duši"
msgstr "Na mou duši"

msgid "no time limit"
msgstr "bez časového omezení"

msgid "until %s"
msgstr "do %s"

msgid "Active"
msgstr "Aktivní"

msgid "Expired"
msgstr "Vypršel"

msgid "Revoked"
msgstr "Odebrán"

msgid "Manual"
msgstr "Ručně"

msgid "Order"
msgstr "Objednávka"

msgid "Webinar \"%s\": no customer account on the order, access not granted."
msgstr "Webinář „%s“: objednávka nemá zákaznický účet, přístup nebyl udělen."

msgid "Access to webinar \"%1$s\" granted: %2$s."
msgstr "Přístup k webináři „%1$s“ udělen: %2$s."

msgid "Access to webinar \"%s\" revoked."
msgstr "Přístup k webináři „%s“ odebrán."

msgid "Webinar access"
msgstr "Přístupy k webinářům"

msgid "No webinar access granted by this order."
msgstr "Tato objednávka neudělila přístup k žádnému webináři."

msgid "Webinar"
msgstr "Webinář"

msgid "Source"
msgstr "Zdroj"

msgid "Granted"
msgstr "Uděleno"

msgid "Expires"
msgstr "Platnost do"

msgid "Status"
msgstr "Stav"

msgid "Revoke"
msgstr "Odebrat"

msgid "No webinar access yet."
msgstr "Zatím žádné přístupy k webinářům."

msgid "Grant access"
msgstr "Udělit přístup"

msgid "— Select —"
msgstr "— Vyberte —"

msgid "Access until"
msgstr "Přístup do"

msgid "Leave empty for no time limit. Replaces any existing expiry of this webinar."
msgstr "Prázdné = bez časového omezení. Nahradí dosavadní platnost přístupu k tomuto webináři."

msgid "Na mou duši – Webináře requires WooCommerce to be active."
msgstr "Na mou duši – Webináře vyžaduje aktivní WooCommerce."

msgid "Na mou duši – Webináře: missing wp-config.php constants:"
msgstr "Na mou duši – Webináře: ve wp-config.php chybí konstanty:"

msgid "Webinar type"
msgstr "Typ webináře"

msgid "— Not a webinar —"
msgstr "— Není webinář —"

msgid "Recorded"
msgstr "Nahraný"

msgid "Live (Zoom)"
msgstr "Živý (Zoom)"

msgid "Webinar products are always virtual and sold one per customer."
msgstr "Webináře jsou vždy virtuální produkty a každý zákazník je může koupit jen jednou."

msgid "Access (days)"
msgstr "Přístup (dny)"

msgid "No time limit"
msgstr "Bez časového omezení"

msgid "Empty = no time limit. Live: counted from the event start; recorded: from the purchase."
msgstr "Prázdné = bez časového omezení. Živý: počítá se od začátku akce; nahraný: od nákupu."

msgid "Bunny video ID"
msgstr "ID videa v Bunny"

msgid "Required for recorded webinars. For live webinars, add the recording here after the event."
msgstr "Povinné u nahraných webinářů. U živých sem po akci doplňte záznam."

msgid "Start"
msgstr "Začátek"

msgid "Time in %s."
msgstr "Čas v zóně %s."

msgid "Duration (minutes)"
msgstr "Délka (minuty)"

msgid "Zoom ID"
msgstr "Zoom ID"

msgid "Can be added later; buyers are then registered automatically. Registration must be enabled in Zoom."
msgstr "Lze doplnit později; kupující se pak zaregistrují automaticky. V Zoomu musí být zapnutá registrace."

msgid "Zoom type"
msgstr "Typ v Zoomu"

msgid "Meeting"
msgstr "Meeting"

msgid "Webinar (Zoom Webinars add-on)"
msgstr "Webinar (doplněk Zoom Webinars)"

msgid "Recorded webinar: the Bunny video ID is missing."
msgstr "Nahraný webinář: chybí ID videa v Bunny."

msgid "Live webinar: the start date and time are missing."
msgstr "Živý webinář: chybí datum a čas začátku."

msgid "You already have access to this webinar."
msgstr "K tomuto webináři už máte přístup."

msgid "Go to webinar"
msgstr "Přejít na webinář"

msgid "Go to My webinars"
msgstr "Přejít na Moje webináře"

msgid "My webinars"
msgstr "Moje webináře"

msgid "The document does not exist."
msgstr "Dokument neexistuje."

msgid "You do not have access to this document."
msgstr "K tomuto dokumentu nemáte přístup."

msgid "Back to My webinars"
msgstr "Zpět na Moje webináře"

msgid "Documents"
msgstr "Dokumenty"

msgid "Title"
msgstr "Název"

msgid "File"
msgstr "Soubor"

msgid "Delete"
msgstr "Smazat"

msgid "Only customers with access can download these files; they are not in the media library."
msgstr "Soubory si mohou stáhnout jen zákazníci s přístupem; nejsou v knihovně médií."

msgid "Document \"%1$s\" was not uploaded: %2$s"
msgstr "Dokument „%1$s“ se nepodařilo nahrát: %2$s"

msgid "You do not have access to this webinar."
msgstr "K tomuto webináři nemáte přístup."

msgid "Buy access"
msgstr "Koupit přístup"

msgid "Live webinar"
msgstr "Živý webinář"

msgid "Join on Zoom"
msgstr "Připojit se přes Zoom"

msgid "This link is personal – please do not share it."
msgstr "Odkaz je osobní – prosíme, nesdílejte ho."

msgid "We will add your personal Zoom link here before the webinar starts and send it to you by email."
msgstr "Osobní odkaz na Zoom sem doplníme před začátkem webináře a pošleme vám ho e-mailem."

msgid "Access: %s"
msgstr "Přístup: %s"

msgid "You have no webinars yet."
msgstr "Zatím nemáte žádné webináře."

msgid "Browse webinars"
msgstr "Prohlédnout webináře"

msgid "Live webinar · %s"
msgstr "Živý webinář · %s"

msgid "Recorded webinar"
msgstr "Nahraný webinář"

msgid "Access has expired."
msgstr "Přístup vypršel."

msgid "Buy again"
msgstr "Koupit znovu"

msgid "%d minute"
msgid_plural "%d minutes"
msgstr[0] "%d minuta"
msgstr[1] "%d minuty"
msgstr[2] "%d minut"

msgid "Recording"
msgstr "Záznam"

msgid "Video"
msgstr "Video"

msgid "The video cannot be played right now. Please try again later or contact us."
msgstr "Video teď nelze přehrát. Zkuste to prosím později, nebo nás kontaktujte."

msgid "The Bunny video ID should look like 1b2c3d4e-0000-4a5b-8c9d-0123456789ab (Stream → video → Video ID)."
msgstr "ID videa v Bunny má tvar 1b2c3d4e-0000-4a5b-8c9d-0123456789ab (Stream → video → Video ID)."

msgid "This webinar has no date yet."
msgstr "Tento webinář zatím nemá termín."

msgid "Zoom: registered"
msgstr "Zoom: zaregistrován"

msgid "Zoom: waiting for registration"
msgstr "Zoom: čeká na registraci"

msgid "Your personal Zoom link will be on the webinar page: %s"
msgstr "Váš osobní odkaz na Zoom najdete na stránce webináře: %s"

msgid "Sent on new webinar access (purchase or manual grant); for live webinars with the personal Zoom link and a calendar file."
msgstr "Odesílá se při novém přístupu k webináři (nákup nebo ruční udělení); u živých webinářů s osobním odkazem na Zoom a souborem do kalendáře."

msgid "Webinar access granted"
msgstr "Udělený přístup k webináři"

msgid "Your access to {webinar}"
msgstr "Váš přístup k webináři {webinar}"

msgid "Your webinar is ready"
msgstr "Váš webinář je připraven"

msgid "Thank you! You now have access to the webinar below. You will always find it in your account under My webinars."
msgstr "Děkujeme! Nyní máte přístup k webináři níže. Kdykoli ho najdete ve svém účtu v sekci Moje webináře."

msgid "Webinar Zoom link"
msgstr "Odkaz na Zoom pro webinář"

msgid "Sent when the personal Zoom link becomes available or changes after the purchase."
msgstr "Odesílá se, když je osobní odkaz na Zoom po nákupu k dispozici nebo se změní."

msgid "Your Zoom link for {webinar}"
msgstr "Váš odkaz na Zoom: {webinar}"

msgid "Your Zoom link is ready"
msgstr "Váš odkaz na Zoom je připraven"

msgid "Your personal link to the live webinar is ready. Please do not share it – it only works for you."
msgstr "Váš osobní odkaz na živý webinář je připraven. Prosíme, nesdílejte ho – funguje jen pro vás."

msgid "When:"
msgstr "Kdy:"

msgid "We will send you your personal Zoom link before the webinar starts. You will also find it on the webinar page."
msgstr "Osobní odkaz na Zoom vám pošleme před začátkem webináře. Najdete ho také na stránce webináře."

msgid "Open the webinar page"
msgstr "Otevřít stránku webináře"

msgid "The attached calendar file adds the webinar to your calendar."
msgstr "Přiložený soubor přidá webinář do vašeho kalendáře."

msgid "Add to calendar (.ics)"
msgstr "Přidat do kalendáře (.ics)"

msgid "Join: %1$s\nWebinar page: %2$s"
msgstr "Připojit se: %1$s\nStránka webináře: %2$s"
