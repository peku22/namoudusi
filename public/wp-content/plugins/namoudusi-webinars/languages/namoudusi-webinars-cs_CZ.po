msgstr "Zákazník souhlasil se zpřístupněním digitálního obsahu ihned: „%s“"

#: src/Email/AccessGrantedEmail.php:12
msgid "Webinar access granted"
msgstr "Udělený přístup k webináři"

#: src/Email/AccessGrantedEmail.php:13
msgid "Sent on new webinar access (purchase or manual grant); for live webinars with the personal Zoom link and a calendar file."
msgstr "Odesílá se při novém přístupu k webináři (nákup nebo ruční udělení); u živých webinářů s osobním odkazem na Zoom a souborem do kalendáře."

#: src/Email/AccessGrantedEmail.php:22
msgid "Your access to {webinar}"
msgstr "Váš přístup k webináři {webinar}"

#: src/Email/AccessGrantedEmail.php:27
msgid "Your webinar is ready"
msgstr "Váš webinář je připraven"

#: src/Email/AccessGrantedEmail.php:32
msgid "Thank you! You now have access to the webinar below. You will always find it in your account under My webinars."
msgstr "Děkujeme! Nyní máte přístup k webináři níže. Kdykoli ho najdete ve svém účtu v sekci Moje webináře."

#: src/Email/ReminderEmail.php:17
msgid "Live webinar reminder"
msgstr "Připomínka živého webináře"

#: src/Email/ReminderEmail.php:18
msgid "Sent to buyers of a live webinar 24 hours and 1 hour before it starts."
msgstr "Odesílá se kupujícím živého webináře 24 hodin a 1 hodinu před začátkem."

#: src/Email/ReminderEmail.php:30
msgid "Reminder: {webinar} starts {start}"
msgstr "Připomínka: {webinar} – {start}"

#: src/Email/ReminderEmail.php:35
msgid "Your webinar starts soon"
msgstr "Váš webinář brzy začíná"

#: src/Email/ReminderEmail.php:41
msgid "Your webinar starts in an hour. Join with your personal link below – we look forward to seeing you."
msgstr "Váš webinář začíná za hodinu. Připojte se svým osobním odkazem níže – těšíme se na vás."

#: src/Email/ReminderEmail.php:42
msgid "Your webinar starts tomorrow. Here is everything you need to join."
msgstr "Váš webinář začíná zítra. Tady je vše, co k připojení potřebujete."

#: src/Email/ScheduleChangedEmail.php:12
msgid "Live webinar time changed"
msgstr "Změna termínu živého webináře"

#: src/Email/ScheduleChangedEmail.php:13
msgid "Sent to buyers of a live webinar when its start time changes, with an updated calendar file."
msgstr "Odesílá se kupujícím živého webináře, když se změní čas začátku; obsahuje aktualizovaný soubor do kalendáře."

#: src/Email/ScheduleChangedEmail.php:22
msgid "New date: {webinar} – {start}"
msgstr "Nový termín: {webinar} – {start}"

#: src/Email/ScheduleChangedEmail.php:27
msgid "The webinar time has changed"
msgstr "Termín webináře se změnil"

#: src/Email/ScheduleChangedEmail.php:32
msgid "The live webinar you bought has a new date and time. The attached calendar file updates the event in your calendar."
msgstr "Živý webinář, který jste si koupili, má nový termín. Přiložený soubor aktualizuje událost ve vašem kalendáři."

#: src/Email/ZoomLinkEmail.php:12
msgid "Webinar Zoom link"
msgstr "Odkaz na Zoom pro webinář"

#: src/Email/ZoomLinkEmail.php:13
msgid "Sent when the personal Zoom link becomes available or changes after the purchase."
msgstr "Odesílá se, když je osobní odkaz na Zoom po nákupu k dispozici nebo se změní."

#: src/Email/ZoomLinkEmail.php:19
msgid "Your Zoom link for {webinar}"
msgstr "Váš odkaz na Zoom: {webinar}"

#: src/Email/ZoomLinkEmail.php:24
msgid "Your Zoom link is ready"
msgstr "Váš odkaz na Zoom je připraven"

#: src/Email/ZoomLinkEmail.php:29
msgid "Your personal link to the live webinar is ready. Please do not share it – it only works for you."
msgstr "Váš osobní odkaz na živý webinář je připraven. Prosíme, nesdílejte ho – funguje jen pro vás."

#: src/Plugin.php:106
msgid "Na mou duši – Webináře requires WooCommerce to be active."
msgstr "Na mou duši – Webináře vyžaduje aktivní WooCommerce."

