msgstr "Webináře jsou vždy virtuální produkty a každý zákazník je může koupit jen jednou."

msgid "Access (days)"
msgstr "Přístup (dny)"

msgid "No time limit"
msgstr "Bez časového omezení"

msgid "Empty = no time limit. Live: counted from the event start; recorded: from the purchase."
msgstr "Prázdné = bez časového omezení. Živý: počítá se od začátku akce; nahraný: od nákupu."

