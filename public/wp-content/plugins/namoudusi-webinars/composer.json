{
    "name": "namoudusi/webinars",
    "description": "Recorded and live webinars for WooCommerce (Na mou du\u0161i)",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/woocommerce-stubs": "*",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Namoudusi\\Webinars\\": "src/",
            "Namoudusi\\Webinars\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
